<tr>
    <td><span class="badge">{{ .Type }}</span></td>
    <td>{{ .UserID }}</td>
    <td>{{ .Nickname }}</td>
    <td>{{ .Avatar }}</td>
    <td>{{ .GiftCode }}</td>
    <td>{{ .GiftName }}</td>
    <td>{{ .GiftPoint }}</td>
    <td>{{ if eq .GiftFree false }} false {{ end }}</td>
    <td>{{ .GiftType }}</td>
    <td>{{ .Count }}</td><td>{{ .H }}</td>
    <td>{{ .D }}</td>
    <td>{{ .At }}</td>
    <td>{{ .Ua }}</td>
    <td>{{ .Aft }}</td>
    <td>{{ .CreatedAtDisplay }}</td>
    <td>{{ .Cl }}</td>
</tr>
